# Copy this file to .env and fill in real values. Never commit the real .env
# — it's already covered by .gitignore.

# --- Server ---
PORT=5000

# --- Database ---
# Either set DATABASE_URL (preferred for hosted Postgres / single-var setups)...
# DATABASE_URL=postgres://user:password@host:5432/joineazy
# DB_SSL=true

# ...or the discrete vars below (used when DATABASE_URL is not set).
# In Docker Compose, DB_HOST is overridden to "db" automatically.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=joineazy

# Connection pool tuning (optional — sensible defaults are already applied)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# --- Auth ---
# Use a long, random value in any real deployment — never the dev default.
JWT_SECRET=change_me_to_a_long_random_string

# --- CORS / rate limiting ---
# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:5173
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
